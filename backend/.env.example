# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pass_verification

# Set to "true" if your DB provider requires SSL (e.g. Railway)
DATABASE_SSL=false

# Port the Express server listens on
PORT=4000

# Origin allowed to call this API in production (e.g. your Vercel frontend URL).
# Leave unset for local development to allow any origin.
ALLOWED_ORIGIN=
